@model List<tallermigrado.Models.Colores>
@{
    ViewData["Title"] = "Colores";
}

<div class="prod-page">
    <div class="prod-header">
        <div>
            <h1>Colores</h1>
            <p class="text-secundario">Listado de colores registrados.</p>
        </div>
        <a asp-action="Crear" class="btn-prod-primary">Nuevo color</a>
    </div>

    @if (TempData["Mensaje"] is string mensaje)
    {
        <div class="alert alert-success">@mensaje</div>
    }

    <div class="prod-tabla">
        <table class="table">
            <thead>
                <tr>
                    <th>Id</th>
                    <th>Color</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var registro in Model)
                {
                    <tr>
                        <td>@registro.Id</td>
                        <td>@registro.Nombre</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
